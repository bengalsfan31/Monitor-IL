def parse_overview(html: str) -> dict:
    """Pull Overall record, Region record, and state rank from any team page
    (the header block with these stats appears on every team subpage)."""
    soup = BeautifulSoup(html, "lxml")
    text_blocks = [t.strip() for t in soup.stripped_strings]

    def value_after(label: str):
        for i, t in enumerate(text_blocks):
            if t.lower() == label.lower():
                # value is usually the very next non-empty string
                if i + 1 < len(text_blocks):
                    return text_blocks[i + 1]
        return None

    overall = value_after("Overall")
    region = value_after("Region")
    rank = None
    for i, t in enumerate(text_blocks):
        if t.lower().endswith("rank"):
            if i + 1 < len(text_blocks):
                rank = text_blocks[i + 1]
            break

    return {
        "overall_record": overall,
        "region_record": region,
        "state_rank": rank,
    }


def parse_schedule(html: str, sport_slug: str = "football") -> list:
    """Parse MaxPreps schedules across table and card/list layouts.

    MaxPreps has changed the football schedule markup over time. Some pages
    expose a normal <table>, while others render games as cards/divs. This
    parser deliberately supports both layouts.
    """
    soup = BeautifulSoup(html, "lxml")
    games = []
    seen = set()

    date_re = re.compile(r"^\s*(\d{1,2}/\d{1,2})(?:\s*\|?\s*(\d{1,2}:\d{2}\s*[ap]m))?", re.I)
    date_any_re = re.compile(r"\b\d{1,2}/\d{1,2}(?:\s*\d{1,2}:\d{2}\s*[ap]m)?", re.I)
    action_re = re.compile(r"preview game|box ?score|recap|tickets|live stream|watch|score game", re.I)

    def clean_opponent(text):
        if not text:
            return None
        text = re.sub(r"^(?:vs|@)\s*", "", text.strip(), flags=re.I)
        text = re.sub(r"[|•]+.*$", "", text).strip()
        return text or None

    def extract_from_row(row):
        row_text = row.get_text(" ", strip=True)
        if not date_any_re.search(row_text):
            return None

        date_time_raw = None
        for a in row.find_all("a"):
            txt = a.get_text(" ", strip=True)
            if date_re.match(txt):
                date_time_raw = txt
                break
        if date_time_raw is None:
            m = date_any_re.search(row_text)
            date_time_raw = m.group(0) if m else None

        home_away = None
        if re.search(r"(?:^|\s)vs(?:\s|$)", row_text, re.I):
            home_away = "vs"
        elif re.search(r"(?:^|\s)@(?:\s|$)", row_text):
            home_away = "@"

        opp_link = None
        for a in row.find_all("a"):
            href = a.get("href", "") or ""
            text = a.get_text(" ", strip=True)
            if not text or action_re.search(text):
                continue
            if "indian land" in text.lower():
                continue
            if f"/{sport_slug}/" in href and not date_any_re.match(text):
                opp_link = a
                break

        opponent = clean_opponent(opp_link.get_text(" ", strip=True)) if opp_link else None
        if opponent is None and home_away:
            marker = re.search(r"(?:^|\s)(?:vs|@)\s*([^|•]+)", row_text, re.I)
            if marker:
                candidate = clean_opponent(marker.group(1))
                candidate = action_re.sub("", candidate or "").strip()
                if candidate and len(candidate) < 60:
                    opponent = candidate

        if not opponent:
            return None

        result_match = re.search(r"\b([WL])\s*(\d+\s*-\s*\d+)\b", row_text, re.I)
        if result_match:
            result = f"{result_match.group(1).upper()} {result_match.group(2).replace(' ', '')}"
        elif re.search(r"\bfinal\b", row_text, re.I):
            result = "Final (score not parsed)"
        elif re.search(r"\b(ppd|postponed|cancell?ed|forfeit)\b", row_text, re.I):
            result = "Postponed"
        else:
            result = None

        opponent_logo_url = None
        for img in row.find_all("img"):
            src = img.get("src", "") or ""
            alt = img.get("alt", "") or ""
            if "school-mascot" in src and "indian land" not in alt.lower():
                opponent_logo_url = src
                break

        game_info_url = None
        info_link = row.find("a", string=re.compile(r"Preview Game|Box Score|Recap", re.I))
        if info_link:
            game_info_url = info_link.get("href")
        elif opp_link:
            game_info_url = opp_link.get("href")

        key = (_normalize_team_name(opponent), date_time_raw, home_away)
        if key in seen:
            return None
        seen.add(key)
        return {
            "date_time_raw": date_time_raw,
            "opponent": opponent,
            "opponent_logo_url": opponent_logo_url,
            "home_away": home_away,
            "result": result,
            "game_info_url": game_info_url,
        }

    # 1) Preferred: real table rows.
    for tbl in soup.find_all("table"):
        for row in tbl.find_all("tr"):
            game = extract_from_row(row)
            if game:
                games.append(game)

    # 2) Fallback: card/list markup. Start at date links and walk upward.
    if not games:
        for date_link in soup.find_all("a"):
            txt = date_link.get_text(" ", strip=True)
            if not date_re.match(txt):
                continue
            container = date_link
            for _ in range(6):
                container = container.parent
                if container is None:
                    break
                if date_any_re.search(container.get_text(" ", strip=True)):
                    game = extract_from_row(container)
                    if game:
                        games.append(game)
                        break

    # 3) Last-resort fallback for newer div-based football markup.
    if not games:
        for node in soup.find_all(["li", "article", "div"]):
            text = node.get_text(" ", strip=True)
            if len(text) > 500 or not date_any_re.search(text):
                continue
            if not re.search(r"(?:^|\s)(?:vs|@)(?:\s|[A-Z])", text, re.I):
                continue
            game = extract_from_row(node)
            if game:
                games.append(game)

    if not games:
        logging.warning("Could not locate any schedule games in MaxPreps HTML.")
    return games


def parse_up_next(html: str) -> dict:
    """Parse MaxPreps' home-page Up Next card as a schedule fallback."""
    soup = BeautifulSoup(html, "lxml")
    heading = None
    for tag in soup.find_all(["h1", "h2", "h3", "strong", "span", "div"]):
        if tag.get_text(" ", strip=True).lower() == "up next":
            heading = tag
            break
    if heading is None:
        return None

    container = heading
    for _ in range(7):
        container = container.parent
        if container is None:
            break
        text = container.get_text(" ", strip=True)
        if re.search(r"\b\d{1,2}/\d{1,2}\b", text) and re.search(r"(?:vs|@)", text, re.I):
            break
    if container is None:
        return None

    text = container.get_text(" ", strip=True)
    date_match = re.search(r"\b(\d{1,2}/\d{1,2}(?:\s*\d{1,2}:\d{2}\s*[ap]m)?)\b", text, re.I)
    matchup = re.search(r"(?:^|\s)(vs|@)\s*([A-Za-z0-9][A-Za-z0-9 .&'’_-]{2,60}?)(?=\s+(?:Watch|Buy Tickets|Score Game|Preview Game|Game Info|$))", text, re.I)
    if not matchup:
        matchup = re.search(r"(?:^|\s)(vs|@)\s*([A-Za-z0-9][A-Za-z0-9 .&'’_-]{2,60})", text, re.I)
    if not matchup:
        return None

    opponent = matchup.group(2).strip(" .")
    if not opponent or "indian land" in opponent.lower():
        return None

    return {
        "date_time_raw": date_match.group(1) if date_match else "TBD",
        "opponent": opponent,
        "opponent_logo_url": None,
        "home_away": matchup.group(1).lower(),
        "result": None,
        "game_info_url": None,
    }

def parse_team_logo(html: str) -> str:
    """Find Indian Land's own school mascot/logo image URL on a team page."""
    soup = BeautifulSoup(html, "lxml")
    fallback = None
    for img in soup.find_all("img"):
        src = img.get("src", "")
        if "school-mascot" not in src:
            continue
        alt = (img.get("alt") or "")
        if "indian land" in alt.lower():
            return src
        if fallback is None:
            fallback = src  # first mascot image on the page, just in case alt text is missing
    return fallback


def _normalize_team_name(name: str) -> str:
    return re.sub(r"[^a-z0-9]", "", (name or "").lower())


def parse_last_game(html: str, home_team_hint: str = "indian land") -> dict:
    """Parse the "Last Game" widget on a team home page.

    MaxPreps calls out the most recently completed game here -- with the
    final score -- often *before* the full schedule table gets updated
    with a score for that same game. That lag is exactly what was making
    an already-finished game still look like the "next game": the
    schedule page's row for it still had no score in it, so it looked
    upcoming even though it had already been played.

    Returns {"opponent": str, "result": "W 49-0"} or None if there's no
    "Last Game" widget on the page (e.g. season hasn't started yet).
    """
    soup = BeautifulSoup(html, "lxml")
    home_hint_norm = _normalize_team_name(home_team_hint)
    heading = None
    for tag in soup.find_all(["h1", "h2", "h3", "strong", "span", "div"]):
        if tag.get_text(strip=True).lower() == "last game":
            heading = tag
            break
    if heading is None:
        return None

    # The two team score links immediately follow the heading, each like
    # "Indian Land Indian Land49" (name repeated + score glued on the end).
    score_links = []
    for a in heading.find_all_next("a", limit=12):
        text = a.get_text(strip=True)
        m = re.search(r"(\d{1,3})$", text)
        if m and len(text) > len(m.group(1)):
            score_links.append((text, int(m.group(1))))
        if len(score_links) >= 2:
            break

    if len(score_links) < 2:
        return None

    (text1, score1), (text2, score2) = score_links[0], score_links[1]
    if home_hint_norm in _normalize_team_name(text1):
        team_score, opp_score, opp_text = score1, score2, text2
    elif home_hint_norm in _normalize_team_name(text2):
        team_score, opp_score, opp_text = score2, score1, text1
    else:
        return None  # couldn't confidently identify which side is us

    # Strip the trailing score digits off the opponent text, and collapse
    # a duplicated name (name appears twice back-to-back in the raw text).
    opp_name = re.sub(r"\d{1,3}$", "", opp_text).strip()
    half = len(opp_name) // 2
    if half > 2 and opp_name[:half].strip() == opp_name[half:].strip():
        opp_name = opp_name[:half].strip()

    if team_score > opp_score:
        result = f"W {team_score}-{opp_score}"
    elif team_score < opp_score:
        result = f"L {team_score}-{opp_score}"
    else:
        result = f"T {team_score}-{opp_score}"

    return {"opponent": opp_name, "result": result}


def parse_standings(html: str) -> dict:
    """Parse region + class standings tables into {section_name: [rows]}."""
    soup = BeautifulSoup(html, "lxml")
    sections = {}

    tables = soup.find_all("table")

    # Enumerate tables and try to find a nearby heading text
    for tbl in tables:
        heading_text = None
        prev = tbl.find_previous(["h2", "h3"])
        if prev:
            heading_text = prev.get_text(strip=True)
        else:
            heading_text = f"Standings table {len(sections) + 1}"

        rows = []
        for tr in tbl.find_all("tr"):
            cells = [c.get_text(strip=True) for c in tr.find_all(["td", "th"])]
            cells = [c for c in cells if c]
            if not cells:
                continue
            row_text = " ".join(cells)
            if not RECORD_RE.search(row_text):
                continue  # skip header rows without a W-L record
            team_link = tr.find("a")
            team_name = team_link.get_text(strip=True) if team_link else (cells[0] if cells else None)
            record_match = RECORD_RE.search(row_text)
            record = record_match.group(0) if record_match else None
            rows.append({"team": team_name, "record": record, "raw": cells})

        if rows:
            sections[heading_text] = rows

    return sections


def parse_star_players(html: str, sport_slug: str = "football") -> list:
    """Parse the 'Team Leaders' section of the stats page into a list of
    {category, player, value, player_url} dicts.

    MaxPreps shows this as one card/table per stat category (Passing Yards,
    Kills, Goals, Batting Average, etc.) once the coach/stat-keeper has
    entered game data. Early in the season it commonly says
    "Player Stats Not Entered" -- in that case we return an empty list and
    the dashboard shows "No data" instead of erroring.

    Every MaxPreps page also has a sitewide footer nav block headed
    "Popular Sports" listing links to every sport's home page (Football,
    Basketball, Volleyball, ...) -- those links match the same
    `/{sport_slug}/` href pattern as real player-profile links, so without
    scoping the search to the actual Team Leaders section, that footer
    block gets misread as a stat category ("Popular Sports" showing up as
    a player name). We anchor on the "Team Leaders" heading itself and
    only look at headings between it and the next unrelated section.
    """
    soup = BeautifulSoup(html, "lxml")
    page_text = soup.get_text(" ", strip=True)

    if re.search(r"not entered|no data to display", page_text, re.I):
        return []

    NON_STAT_SECTION_MARKERS = (
        "meet the team", "nearby", "popular sports", "popular", "schedule at a glance",
        "standings", "news", "rankings", "roster", "photos", "tickets", "watch",
    )

    all_headings = soup.find_all(["h2", "h3"])
    team_leaders_idx = None
    for i, h in enumerate(all_headings):
        if h.get_text(strip=True).lower() == "team leaders":
            team_leaders_idx = i
            break

    if team_leaders_idx is None:
        # Can't confidently locate the stats section at all -- bail rather
        # than risk pulling from an unrelated part of the page.
        return []

    leaders = []
    MAX_CATEGORY_HEADINGS = 8
    for h in all_headings[team_leaders_idx + 1: team_leaders_idx + 1 + MAX_CATEGORY_HEADINGS]:
        category = h.get_text(strip=True)
        if not category:
            continue
        category_lower = category.lower()
        if category_lower in ("player stats", "game stats", "team stats"):
            continue
        if any(marker in category_lower for marker in NON_STAT_SECTION_MARKERS):
            break  # hit the next real section of the page -- stop scanning

        container = h.find_next(["table", "ul", "div"])
        if container is None:
            continue

        player_links = container.find_all("a", href=re.compile(rf"/{sport_slug}/"))
        for a in player_links[:3]:  # top 3 per category
            player_name = a.get_text(strip=True)
            if not player_name:
                continue
            row = a.find_parent(["tr", "li", "div"]) or a
            row_text = row.get_text(" ", strip=True)
            value_match = re.search(r"[\d,.]+$", row_text) or re.search(r"\b\d[\d,.]*\b", row_text)
            value = value_match.group(0) if value_match else None

            leaders.append({
                "category": category,
                "player": player_name,
                "value": value,
                "player_url": a.get("href"),
            })

        if len(leaders) >= 15:  # safety cap
            break

    return leaders


