def run_once(state_path: Path, html_path: Path = None, refresh_seconds: int = 0) -> list:
    snapshot = build_combined_snapshot()
    old = load_state(state_path)
    combined_changes = diff_combined_snapshots(old, snapshot)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    save_state(state_path, snapshot)
    print_report(snapshot)

    all_changes = []
    for sport in SPORTS:
        for c in combined_changes.get(sport["key"], []):
            all_changes.append(f"[{sport['label']}] {c}")

    if all_changes:
        print("\nCHANGES SINCE LAST CHECK:")
        for c in all_changes:
            print(f"  * {c}")
            logging.info("CHANGE: %s", c)
    else:
        print("\nNo changes since last check.")

    if html_path:
        html = build_dashboard_html(snapshot, combined_changes, refresh_seconds)
        html_path.parent.mkdir(parents=True, exist_ok=True)
        html_path.write_text(html, encoding="utf-8")
        print(f"\nDashboard updated: {html_path.resolve()}")

    return all_changes


def main():
    parser = argparse.ArgumentParser(
        description="Monitor Indian Land Warriors football, basketball, soccer, "
                     "volleyball (girls & boys), baseball, and softball on MaxPreps.")
    parser.add_argument("--once", action="store_true", help="Run a single check and exit.")
    parser.add_argument("--interval", type=int, default=30, help="Minutes between checks (default 30).")
    parser.add_argument("--state", type=str, default=DEFAULT_STATE_FILE, help="Path to state JSON file.")
    parser.add_argument("--log", type=str, default=DEFAULT_LOG_FILE, help="Path to log file.")
    parser.add_argument("--html", type=str, default=DEFAULT_HTML_FILE,
                         help="Path to write the HTML dashboard (default indian_land_dashboard.html).")
    parser.add_argument("--no-html", action="store_true", help="Don't write an HTML dashboard.")
    parser.add_argument("--no-open", action="store_true",
                         help="Don't automatically open the dashboard in your browser.")
    parser.add_argument("--refresh-minutes", type=int, default=None,
                         help="Minutes between the dashboard page's own auto-reload "
                              "(<meta refresh>) in visitors' browsers. Defaults to --interval. "
                              "Set to 0 to disable self-reload (e.g. a one-off --once report "
                              "you don't want auto-reloading). Independent of --interval, which "
                              "controls how often *this script* re-polls MaxPreps -- useful when "
                              "--once is driven by an external scheduler (cron/CI) but you still "
                              "want the published page itself to auto-refresh for readers.")
    args = parser.parse_args()

    state_path = Path(args.state)
    html_path = None if args.no_html else Path(args.html)
    refresh_minutes = args.interval if args.refresh_minutes is None else args.refresh_minutes
    refresh_seconds = max(0, refresh_minutes) * 60

    log_path = Path(args.log)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    logging.basicConfig(
        filename=str(log_path),
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
    )
    # Also echo INFO+ to console
    console = logging.StreamHandler()
    console.setLevel(logging.WARNING)  # keep console clean; report printing handles normal output
    logging.getLogger().addHandler(console)

    if not _HAS_CLOUDSCRAPER:
        print("NOTE: 'cloudscraper' is not installed -- if you hit 406 errors, run:")
        print("      pip install cloudscraper")
        print("      then try again.\n")

    if args.once:
        run_once(state_path, html_path, refresh_seconds=refresh_seconds)
        if html_path and not args.no_open:
            webbrowser.open(html_path.resolve().as_uri())
        return

    print(f"Monitoring Indian Land Warriors sports. Checking every {args.interval} min. "
          f"Ctrl+C to stop.\n")
    if html_path:
        print(f"Dashboard will be written to: {html_path.resolve()}")
        print("It will open automatically in your browser and auto-refresh from there.\n")
    try:
        first_run = True
        while True:
            try:
                run_once(state_path, html_path, refresh_seconds)
                if first_run and html_path and not args.no_open:
                    webbrowser.open(html_path.resolve().as_uri())
                    first_run = False
            except Exception as e:
                logging.error("Error during check: %s", e)
                print(f"Error during check: {e}")
            print(f"\nSleeping {args.interval} minutes...\n")
            time.sleep(args.interval * 60)
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    sys.exit(main())
