# Snapshot / diff
# --------------------------------------------------------------------------- #

def _is_placeholder_opponent(opponent: str) -> bool:
    """True for tournament/TBA placeholder rows (e.g. 'TBA', 'TBA*** (Cavs
    Classic @ Dorman High School)') where the real opponent isn't set yet.
    These sort chronologically before real, confirmed matchups, so picking
    the first unresolved row as "next game" without this check surfaces a
    useless 'Next Game: @ TBA' instead of the next real opponent."""
    if not opponent:
        return True
    stripped = opponent.strip().upper()
    return stripped == "TBA" or stripped.startswith("TBA*") or stripped.startswith("TBA ")


def build_snapshot(pages: dict, sport_slug: str) -> dict:
    home_html = fetch(pages["home"])
    time.sleep(1.5)  # brief pause between requests, like real page navigation
    schedule_html = fetch(pages["schedule"])
    time.sleep(1.5)
    standings_html = fetch(pages["standings"])
    time.sleep(1.5)
    stats_html = fetch(pages["stats"])

    overview = parse_overview(home_html)
    schedule = parse_schedule(schedule_html, sport_slug)
    standings = parse_standings(standings_html)
    star_players = parse_star_players(stats_html, sport_slug)
    team_logo_url = parse_team_logo(home_html)

    last_game = None
    try:
        last_game = parse_last_game(home_html)
    except Exception:
        logging.warning("Could not parse the 'Last Game' widget.", exc_info=True)
    last_game_norm = _normalize_team_name(last_game["opponent"]) if last_game else None

    # Football's MaxPreps page can expose its schedule as a rendered card rather
    # than a normal HTML table. The home-page Up Next card is the reliable
    # fallback for the immediate matchup.
    up_next = None
    try:
        up_next = parse_up_next(home_html)
    except Exception:
        logging.warning("Could not parse the 'Up Next' widget.", exc_info=True)

    next_game = None
    fallback_tba_game = None
    for g in schedule:
        if g["result"] is not None:
            continue
        opp_norm = _normalize_team_name(g.get("opponent") or "")
        if last_game_norm and (last_game_norm in opp_norm or opp_norm in last_game_norm):
            g["result"] = last_game["result"]
            continue
        if _is_placeholder_opponent(g.get("opponent")):
            if fallback_tba_game is None:
                fallback_tba_game = g
            continue
        next_game = g
        break

    if next_game is None and up_next:
        next_game = up_next
    if next_game is None:
        next_game = fallback_tba_game
    if not schedule and up_next:
        schedule = [up_next]


    return {
        "fetched_at": datetime.now().isoformat(timespec="seconds"),
        "overview": overview,
        "next_game": next_game,
        "schedule": schedule,
        "standings": standings,
        "star_players": star_players,
        "team_logo_url": team_logo_url,
    }


def build_combined_snapshot() -> dict:
    """Fetch every sport in SPORTS and bundle the results together."""
    sports_snapshot = {}
    for i, sport in enumerate(SPORTS):
        if i > 0:
            time.sleep(2.0)  # pause between sports, like real navigation
        try:
            sports_snapshot[sport["key"]] = build_snapshot(sport["pages"], sport["slug"])
        except Exception as e:
            logging.error("Failed to fetch %s: %s", sport["label"], e)
            sports_snapshot[sport["key"]] = None

    return {
        "fetched_at": datetime.now().isoformat(timespec="seconds"),
        "sports": sports_snapshot,
    }


def load_state(path: Path):
    if path.exists():
        try:
            return json.loads(path.read_text())
        except json.JSONDecodeError:
            logging.warning("State file was corrupt, starting fresh.")
    return None


def save_state(path: Path, snapshot: dict):
    path.write_text(json.dumps(snapshot, indent=2))


def diff_sport_snapshot(old: dict, new: dict) -> list:
    """Return a list of human-readable change descriptions for one sport."""
    changes = []
    if new is None:
        return changes
    if old is None:
        changes.append("Initial snapshot captured.")
        return changes

    ov_old, ov_new = old.get("overview", {}), new.get("overview", {})
    for key, label in [
        ("overall_record", "Overall record"),
        ("region_record", "Region record"),
        ("state_rank", "State rank"),
    ]:
        if ov_old.get(key) != ov_new.get(key):
            changes.append(f"{label} changed: {ov_old.get(key)} -> {ov_new.get(key)}")

    ng_old, ng_new = old.get("next_game"), new.get("next_game")
    old_opp = ng_old.get("opponent") if ng_old else None
    new_opp = ng_new.get("opponent") if ng_new else None
    old_dt = ng_old.get("date_time_raw") if ng_old else None
    new_dt = ng_new.get("date_time_raw") if ng_new else None
    if (old_opp, old_dt) != (new_opp, new_dt):
        changes.append(
            f"Next game changed: {old_dt} vs/@ {old_opp}  ->  {new_dt} vs/@ {new_opp}"
        )

    # New results posted (a game that had no result now has one)
    old_by_key = {(g.get("date_time_raw"), g.get("opponent")): g for g in old.get("schedule", [])}
    for g in new.get("schedule", []):
        key = (g.get("date_time_raw"), g.get("opponent"))
        prev = old_by_key.get(key)
        if g.get("result") and (prev is None or prev.get("result") != g.get("result")):
            changes.append(
                f"Result posted: {g.get('date_time_raw')} vs/@ {g.get('opponent')} -> {g.get('result')}"
            )

    # Standings movement (team order/records changed within any section)
    old_st, new_st = old.get("standings", {}), new.get("standings", {})
    for section, new_rows in new_st.items():
        old_rows = old_st.get(section)
        if old_rows != new_rows:
            changes.append(f"Standings updated: {section}")

    # Star players / stat leaders (newly posted or updated)
    old_sp, new_sp = old.get("star_players", []), new.get("star_players", [])
    if not old_sp and new_sp:
        changes.append("Player stat leaders have been posted for the first time.")
    elif old_sp != new_sp:
        changes.append("Player stat leaders updated.")

    return changes


def diff_combined_snapshots(old: dict, new: dict) -> dict:
    """Diff every sport; returns {sport_key: [change, ...], ...}."""
    old_sports = (old or {}).get("sports", {}) or {}
    new_sports = new.get("sports", {}) or {}
    changes = {}
    for key, new_snap in new_sports.items():
        changes[key] = diff_sport_snapshot(old_sports.get(key), new_snap)
    return changes


