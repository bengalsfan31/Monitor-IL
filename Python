def _esc(s):
    if s is None:
        return ""
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def _render_stat_cards(overview: dict) -> str:
    return f"""
    <div class="stats-row">
      <div class="stat-card">
        <div class="label">Overall</div>
        <div class="value">{_esc(overview.get('overall_record')) or NO_DATA}</div>
      </div>
      <div class="stat-card">
        <div class="label">Region</div>
        <div class="value">{_esc(overview.get('region_record')) or NO_DATA}</div>
      </div>
      <div class="stat-card">
        <div class="label">SC Rank</div>
        <div class="value">{_esc(overview.get('state_rank')) or NO_DATA}</div>
      </div>
    </div>"""


def _initials(name: str, max_len: int = 2) -> str:
    """Turn a team name into short initials for a badge, e.g. 'Fort Mill' -> 'FM'."""
    if not name:
        return "?"
    words = re.findall(r"[A-Za-z0-9]+", name)
    if not words:
        return "?"
    if len(words) == 1:
        return words[0][:max_len].upper()
    return "".join(w[0] for w in words[:max_len]).upper()


def _team_badge_html(logo_url, initials, extra_class="") -> str:
    """Render a team badge as the real school logo image when we have one,
    falling back to a text-initials circle (also used if the image 404s)."""
    initials_esc = _esc(initials)
    if logo_url:
        cls = f"team-badge logo-img {extra_class}".strip()
        return (f'<img class="{cls}" src="{_esc(logo_url)}" alt="{initials_esc}" '
                f"loading=\"lazy\" onerror=\"logoFallback(this,'{initials_esc}')\">")
    return f'<div class="team-badge {extra_class}">{initials_esc}</div>'


def _render_next_game(next_game: dict, team_logo_url: str = None) -> str:
    if next_game:
        opponent = next_game.get('opponent') or 'TBD'
        ha = (next_game.get('home_away') or '').strip()
        vs_text = '@' if ha == '@' else 'VS'
        home_badge = _team_badge_html(team_logo_url, "IL")
        opp_badge = _team_badge_html(next_game.get('opponent_logo_url'), _initials(opponent), "opp-badge")
        return f"""
          <div class="next-game">
            <div class="ng-label">Next Game</div>
            <div class="matchup-row">
              <div class="team-side">
                {home_badge}
                <div class="team-name">Indian Land</div>
              </div>
              <div class="vs-wrap"><span class="vs-text">{vs_text}</span></div>
              <div class="team-side">
                {opp_badge}
                <div class="team-name">{_esc(opponent)}</div>
              </div>
            </div>
            <div class="ng-date">{_esc(next_game.get('date_time_raw'))}</div>
          </div>"""
    return f"""
          <div class="next-game next-game-empty">
            <div class="ng-label">Next Game</div>
            <div class="no-data">{NO_DATA} \u2014 schedule not yet posted.</div>
          </div>"""


def _render_schedule_table(schedule: list) -> str:
    if not schedule:
        return f"""
    <div class="card">
      <h2>Full Schedule</h2>
      <div class="no-data">{NO_DATA}</div>
    </div>"""
    rows = ""
    for g in schedule:
        result = g.get("result")
        opponent = g.get('opponent') or 'Unknown'
        if result:
            badge_class = "badge-win" if result.startswith("W") else (
                "badge-loss" if result.startswith("L") else "badge-final")
            result_html = f'<span class="badge {badge_class}">{_esc(result)}</span>'
        elif _is_placeholder_opponent(opponent):
            result_html = '<span class="badge badge-tba">TBA</span>'
        else:
            result_html = '<span class="badge badge-upcoming">Upcoming</span>'
        logo_url = g.get('opponent_logo_url')
        if logo_url:
            opp_cell = (f'<img class="sched-logo" src="{_esc(logo_url)}" alt="" loading="lazy" '
                        f'onerror="this.remove()">{_esc(opponent)}')
        else:
            opp_cell = _esc(opponent)
        rows += f"""
          <tr>
            <td>{_esc(g.get('date_time_raw')) or 'TBD'}</td>
            <td>{_esc(g.get('home_away'))}</td>
            <td class="opp-cell">{opp_cell}</td>
            <td>{result_html}</td>
          </tr>"""
    return f"""
    <div class="card">
      <h2>Full Schedule</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th></th><th>Opponent</th><th>Result</th></tr></thead>
        <tbody>{rows}</tbody>
      </table>
      </div>
    </div>"""


def _render_standings(standings: dict) -> str:
    if not standings:
        return f"""
    <div class="card">
      <h2>Standings</h2>
      <div class="no-data">{NO_DATA}</div>
    </div>"""
    section_html = ""
    for section, rows in standings.items():
        row_html = ""
        for idx, r in enumerate(rows, start=1):
            team = r.get("team") or "Unknown"
            is_il = "Indian Land" in team
            row_html += f"""
              <tr class="{'highlight' if is_il else ''}">
                <td><span class="rank-chip">{idx}</span>{_esc(team)}</td>
                <td>{_esc(r.get('record')) or '-'}</td>
              </tr>"""
        section_html += f"""
          <div class="standings-section">
            <h3>{_esc(section)}</h3>
            <div class="table-wrap">
            <table>
              <thead><tr><th>Team</th><th>Record</th></tr></thead>
              <tbody>{row_html}</tbody>
            </table>
            </div>
          </div>"""
    return f"""
    <div class="card">
      <h2>Standings</h2>
      {section_html}
    </div>"""


def _render_star_players(star_players: list) -> str:
    if star_players:
        by_category = {}
        for sp in star_players:
            by_category.setdefault(sp["category"], []).append(sp)
        body = ""
        for category, players in by_category.items():
            cards = ""
            for sp in players:
                url = sp.get("player_url") or "#"
                value = _esc(sp.get("value")) if sp.get("value") else ""
                cards += f"""
                  <a class="player-card" href="{_esc(url)}" target="_blank" rel="noopener">
                    <div class="player-name">{_esc(sp.get('player'))}</div>
                    <div class="player-value">{value}</div>
                  </a>"""
            body += f"""
              <div class="star-category">
                <h3>{_esc(category)}</h3>
                <div class="player-row">{cards}</div>
              </div>"""
    else:
        body = f'<div class="no-data">{NO_DATA} \u2014 MaxPreps shows no player stats entered for this team yet.</div>'
    return f"""
    <div class="card">
      <h2>Star Players</h2>
      {body}
    </div>"""


def _render_changes(changes: list) -> str:
    if changes:
        body = "<ul class='changes-list'>" + "".join(
            f"<li>{_esc(c)}</li>" for c in changes) + "</ul>"
    else:
        body = "<p class='no-changes'>No changes since the last check.</p>"
    return f"""
    <div class="card">
      <h2>Recent Changes</h2>
      {body}
    </div>"""


def _render_sport_main(snapshot: dict, changes: list) -> str:
    if snapshot is None:
        return f"""
    <div class="card">
      <h2>Status</h2>
      <div class="no-data">{NO_DATA} \u2014 could not fetch this sport's MaxPreps pages.</div>
    </div>"""
    return f"""
    {_render_stat_cards(snapshot.get('overview', {}))}
    {_render_next_game(snapshot.get('next_game'), snapshot.get('team_logo_url'))}
    {_render_schedule_table(snapshot.get('schedule', []))}
    {_render_standings(snapshot.get('standings', {}))}
    {_render_star_players(snapshot.get('star_players', []))}
    {_render_changes(changes)}"""


def _render_ticker(sports_snapshot: dict) -> str:
    """One scrolling ESPN-style bottom-line item per sport: icon, name, and
    overall record (or 'No data' when the team page hasn't posted one)."""
    items = []
    for sport in SPORTS:
        snap = sports_snapshot.get(sport["key"])
        record = NO_DATA
        if snap:
            record = (snap.get("overview", {}) or {}).get("overall_record") or NO_DATA
        items.append(
            f'<span class="ticker-item">{sport["icon"]} '
            f'{_esc(sport["label"].upper())} <strong>{_esc(record)}</strong></span>'
        )
    track = "".join(items)
    return track + track  # duplicated so the CSS loop scrolls seamlessly


