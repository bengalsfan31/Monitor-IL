<body>

  <div class="loading-overlay active" id="loading-overlay">
    <div class="spinner"></div>
    <div class="loading-text">Loading Scoreboard<span class="loading-dots"><span>.</span><span>.</span><span>.</span></span></div>
  </div>

  <header>
    {header_badge_html}
    <div>
      <h1>Indian Land Warriors</h1>
      <div class="sub"><span class="live-dot"></span>Indian Land, SC &middot; <span id="last-checked" data-fetched-at="{fetched_at}">Last checked {fetched_at}</span></div>
    </div>
    <button class="refresh-btn" id="refresh-btn" onclick="location.reload()" aria-label="Refresh dashboard now" title="Refresh now">&#8635;</button>
  </header>

  <div class="ticker"><div class="ticker-track">{ticker_html}</div></div>

  <nav class="sport-toggle" role="tablist" aria-label="Sport">
    {"".join(tab_buttons)}
  </nav>

  {"".join(pages_html)}

  <script>
    var SPORT_KEYS = [{sport_keys_js}];
    var TAB_STORAGE_KEY = 'il-warriors-active-tab';

    function logoFallback(img, text) {{
      var div = document.createElement('div');
      div.className = img.className.replace('logo-img', '').trim();
      div.textContent = text;
      img.replaceWith(div);
    }}

    function showLoading(cb) {{
      var overlay = document.getElementById('loading-overlay');
      overlay.classList.add('active');
      setTimeout(function() {{
        overlay.classList.remove('active');
        if (cb) cb();
      }}, 500);
    }}

    function showSport(key, opts) {{
      opts = opts || {{}};
      function apply() {{
        var pages = document.querySelectorAll('.page');
        pages.forEach(function(el) {{ el.classList.remove('active'); }});
        var tabs = document.querySelectorAll('.tab-btn');
        tabs.forEach(function(el) {{
          el.classList.remove('active');
          el.setAttribute('aria-selected', 'false');
          el.setAttribute('tabindex', '-1');
        }});
        var page = document.getElementById('page-' + key);
        var tab = document.getElementById('tab-' + key);
        if (page) {{ page.classList.add('active'); }}
        if (tab) {{
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');
        }}
        var main = page ? page.querySelector('main') : null;
        if (main) {{
          main.classList.remove('pulse-in');
          void main.offsetWidth; // reflow to restart the animation
          main.classList.add('pulse-in');
        }}
        try {{ localStorage.setItem(TAB_STORAGE_KEY, key); }} catch (e) {{ /* storage unavailable */ }}
      }}
      if (opts.silent) {{ apply(); }} else {{ showLoading(apply); }}
    }}

    // Arrow-key navigation between tabs, per standard ARIA tab pattern.
    document.addEventListener('keydown', function(e) {{
      if (e.target && e.target.classList && e.target.classList.contains('tab-btn') &&
          (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) {{
        var idx = SPORT_KEYS.indexOf(e.target.getAttribute('data-key'));
        if (idx === -1) return;
        var next = e.key === 'ArrowRight'
          ? (idx + 1) % SPORT_KEYS.length
          : (idx - 1 + SPORT_KEYS.length) % SPORT_KEYS.length;
        var nextTab = document.getElementById('tab-' + SPORT_KEYS[next]);
        if (nextTab) {{ nextTab.focus(); showSport(SPORT_KEYS[next]); }}
        e.preventDefault();
      }}
    }});

    function updateLastChecked() {{
      var el = document.getElementById('last-checked');
      if (!el) return;
      var iso = el.getAttribute('data-fetched-at');
      var then = new Date(iso);
      if (isNaN(then.getTime())) return;
      var secs = Math.max(0, Math.round((Date.now() - then.getTime()) / 1000));
      var label;
      if (secs < 60) {{ label = 'just now'; }}
      else if (secs < 3600) {{ label = Math.round(secs / 60) + ' min ago'; }}
      else {{ label = Math.round(secs / 3600) + ' hr ago'; }}
      el.textContent = 'Last checked ' + label;
    }}

    document.addEventListener('DOMContentLoaded', function() {{
      // Restore whichever sport tab the user had open before the page's
      // periodic auto-refresh reloaded it, so they don't get bounced back
      // to the first tab every {refresh_minutes} minutes.
      try {{
        var saved = localStorage.getItem(TAB_STORAGE_KEY);
        if (saved && SPORT_KEYS.indexOf(saved) !== -1) {{
          showSport(saved, {{ silent: true }});
        }}
      }} catch (e) {{ /* storage unavailable, keep server-rendered default tab */ }}

      updateLastChecked();
      setInterval(updateLastChecked, 30000);

      setTimeout(function() {{
        var overlay = document.getElementById('loading-overlay');
        if (overlay) {{ overlay.classList.remove('active'); }}
      }}, 700);
    }});
  </script>
</body>
